#!/Users/danny/Documents/Tools/NativePeers/.venv/bin/python
"""Harness-only stand-in for `npeer bridge`: the real bridge server over the replay backend."""
import argparse, asyncio, json, os, sys
HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path[:0] = [HERE, os.path.abspath(os.path.join(HERE, '..', '..', '..'))]
from nativepeers.bridge import Bridge, socket_path
from replay_backend import ReplayBackend

parser = argparse.ArgumentParser()
parser.add_argument('command', choices=['bridge'])
parser.add_argument('--claude-session', required=True)
parser.add_argument('--protocol', type=int, default=1)
parser.add_argument('--json', action='store_true')
args = parser.parse_args()
scenario = json.load(open(os.environ['NP_REPLAY_SCENARIO']))
backend = ReplayBackend(scenario, os.environ.get('NP_REPLAY_LOG'), args.claude_session)
backend.log('start', session=args.claude_session, argv=sys.argv[1:], ppid=os.getppid())
reason = asyncio.run(Bridge(backend, socket_path('replay-' + args.claude_session), heartbeat_loss=int(os.environ.get('NP_REPLAY_HEARTBEAT', '60'))).run())
print(json.dumps({'exit': reason}), file=sys.stderr)
