{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NativePeers usage status v1",
  "type": "object",
  "required": [
    "schema_version",
    "providers",
    "inference_submitted",
    "quota_reserved",
    "local_usage"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "inference_submitted": {
      "const": false
    },
    "quota_reserved": {
      "const": false
    },
    "providers": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "provider",
          "home",
          "state",
          "source",
          "pools",
          "models",
          "confidence"
        ],
        "properties": {
          "provider": {
            "enum": [
              "claude",
              "codex",
              "antigravity",
              "grok"
            ]
          },
          "home": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "confidence": {
            "type": "string"
          },
          "state": {
            "enum": [
              "AVAILABLE",
              "LIMITED",
              "EXHAUSTED",
              "UNKNOWN",
              "STALE",
              "AUTH_REQUIRED",
              "MODEL_UNAVAILABLE",
              "CAPABILITY_MISMATCH"
            ]
          },
          "pools": {
            "type": "array",
            "maxItems": 512,
            "items": {
              "type": "object",
              "required": [
                "pool_id",
                "state",
                "unit",
                "field_basis",
                "membership",
                "freshness"
              ],
              "properties": {
                "pool_id": {
                  "type": "string",
                  "maxLength": 256
                },
                "unit": {
                  "type": "string"
                },
                "disabled": {
                  "type": "boolean"
                },
                "limiting": {
                  "type": "boolean"
                },
                "observed_at": {
                  "type": "number"
                },
                "models": {
                  "type": "array",
                  "maxItems": 64,
                  "items": {
                    "type": "string"
                  }
                },
                "field_basis": {
                  "type": "object"
                }
              }
            }
          },
          "models": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "required": [
                "model",
                "state",
                "pool_ids",
                "reasons"
              ]
            }
          },
          "collection": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "outcome": {
                "enum": [
                  "FRESH",
                  "CACHED",
                  "UNVERIFIED",
                  "UNAVAILABLE"
                ]
              },
              "request_started_at": {
                "type": "number"
              },
              "request_completed_at": {
                "type": "number"
              },
              "provider_observed_at": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "freshness_basis": {
                "type": "string"
              },
              "native_cache_age_seconds": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "credits_coverage": {
                "enum": [
                  "UNKNOWN",
                  "REPORTED"
                ]
              },
              "cleanup": {
                "type": "object"
              }
            }
          },
          "collector_state": {
            "type": "string"
          }
        }
      }
    },
    "local_usage": {
      "type": "object"
    },
    "recommendations": {
      "type": "object"
    }
  }
}
