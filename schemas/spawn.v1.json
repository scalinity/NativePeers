{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NativePeers spawn v1",
  "type": "object",
  "required": [
    "workers"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "client_request_id": {
      "type": "string"
    },
    "workers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "provider",
          "title",
          "task"
        ],
        "properties": {
          "provider": {
            "enum": [
              "claude",
              "codex",
              "antigravity",
              "grok"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "task": {
            "type": "string"
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Native model ID or supported alias, for each provider. Omit to resolve the configured default once at spawn."
          },
          "reasoning_effort": {
            "type": "string"
          },
          "permission_profile": {
            "enum": [
              "analysis",
              "workspace"
            ]
          },
          "workspace": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": {
                "enum": [
                  "inherit-read-only",
                  "isolated-worktree",
                  "isolated-copy"
                ]
              },
              "untracked_allowlist": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "file_allowlist": {
                "type": "array",
                "minItems": 1,
                "maxItems": 256,
                "description": "Explicit relative regular files for a non-Git isolated-copy workspace; the batch union is limited to 256 files and 10 MiB.",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              }
            }
          },
          "context_refs": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "pattern": "^art_"
            }
          },
          "result_format": {
            "const": "nativepeers.result.v1"
          },
          "fallbacks": {
            "type": "array",
            "maxItems": 3,
            "description": "Ordered explicit Gemini alternatives for a Claude task. Only confirmed no-execution quota/auth failures may advance; budgets and frozen inputs are retained.",
            "items": {
              "type": "object",
              "required": [
                "provider",
                "model"
              ],
              "additionalProperties": false,
              "properties": {
                "provider": {
                  "const": "antigravity"
                },
                "model": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              }
            }
          },
          "requirements": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "title": "NativePeers task requirements v1",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "task_type": {
                "enum": [
                  "implementation",
                  "architecture",
                  "debugging",
                  "research",
                  "review",
                  "documentation",
                  "transformation"
                ]
              },
              "complexity": {
                "enum": [
                  "routine",
                  "standard",
                  "demanding"
                ]
              },
              "quality": {
                "enum": [
                  "routine",
                  "standard",
                  "demanding"
                ]
              },
              "context_tokens": {
                "type": "integer",
                "minimum": 1
              },
              "required_tools": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "maxLength": 128
                }
              },
              "modalities": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "maxLength": 128
                }
              },
              "reasoning_effort": {
                "type": "string",
                "maxLength": 32
              },
              "independent_from_vendor": {
                "type": "string",
                "maxLength": 128
              },
              "model": {
                "type": "string",
                "maxLength": 512
              }
            }
          },
          "quota_policy": {
            "enum": [
              "respect-known-limits",
              "warn"
            ],
            "description": "Fresh known exhaustion stops submission by default. warn explicitly attempts the exact choice anyway; it never changes the model or permissions."
          }
        },
        "additionalProperties": false
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_concurrent_workers": {
          "type": "integer",
          "minimum": 1
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1
        },
        "wall_time_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_task_turns_per_worker": {
          "type": "integer",
          "minimum": 1
        },
        "followup_grace_seconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "completion_mode": {
      "enum": [
        "push",
        "wait"
      ]
    },
    "failure_policy": {
      "const": "collect-all"
    },
    "allow_sibling_messages": {
      "type": "boolean"
    },
    "survive_parent": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
